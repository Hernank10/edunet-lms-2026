{% extends "base.html" %}
{% block content %}
<div class="container mt-5" style="max-width: 500px;">
  <h2>📝 Registro</h2>
  <form method="post">
    {% csrf_token %}
    {{ form.as_p }}
    <button type="submit" class="btn btn-primary w-100">Registrarme</button>
  </form>
  <p class="mt-3">
    ¿Ya tienes cuenta?
    <a href="{% url 'login' %}">Inicia sesión</a>
  </p>
</div>
{% endblock %}
