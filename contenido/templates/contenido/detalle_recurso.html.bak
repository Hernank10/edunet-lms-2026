{% extends "base.html" %}

{% block content %}
<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="{% url 'contenido:hub' %}">Contenido</a></li>
      <li class="breadcrumb-item"><a href="{% url 'contenido:lista_recursos' %}">Recursos</a></li>
      <li class="breadcrumb-item active">{{ recurso.titulo|truncatechars:40 }}</li>
    </ol>
  </nav>

  <h1>{{ recurso.titulo }}</h1>
  {% if recurso.subtitulo %}
    <p class="lead text-muted">{{ recurso.subtitulo }}</p>
  {% endif %}

  <div class="mb-4">
    <span class="badge bg-secondary">{{ recurso.get_categoria_display }}</span>
    <span class="badge bg-info">{{ recurso.get_nivel_display }}</span>
    <span class="badge bg-primary">{{ tecnicas|length }} técnicas</span>
    {% if recurso.bilingue %}<span class="badge bg-warning">🌐 Bilingüe</span>{% endif %}
  </div>

  <h3 class="mb-3">Técnicas</h3>
  <div class="list-group">
    {% for t in tecnicas %}
      <a href="{% url 'contenido:tecnica' t.pk %}"
         class="list-group-item list-group-item-action">
        <div class="d-flex justify-content-between">
          <div>
            <strong>{{ t.numero }}. {{ t.nombre }}</strong>
            {% if t.categoria_interna %}
              <br><small class="text-muted">{{ t.categoria_interna }}</small>
            {% endif %}
          </div>
          <span class="badge bg-secondary align-self-center">→</span>
        </div>
      </a>
    {% empty %}
      <p class="text-muted">Este recurso no tiene técnicas.</p>
    {% endfor %}
  </div>
</div>
{% endblock %}
